[Unit]
# Single-service Maestro (epic #754, Phase 6 cutover): one maestro.service runs
# `maestro daemon`, which drives EVERY config-store project in one process — an
# orchestrator + supervisor loop per project plus one aggregating fleet web
# server on :8786. It replaces the old per-project topology (the maestro@.service
# template + per-project supervise/serve units, ~15 units in total).
Description=Maestro agent orchestrator (single-service daemon, all projects)
After=network.target

[Service]
User=god
WorkingDirectory=/home/god
Type=simple
Environment=PATH=/home/god/.local/bin:/home/god/.bun/bin:/home/god/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# One unified SQLite database (/home/god/.maestro/maestro.db) holds config + approvals +
# state; --approvals-db / --state-db default to that same file. --watch-store lets
# the daemon hot add/remove/reload projects from the store (and powers dashboard
# project CRUD: POST/DELETE /api/v1/fleet/projects) without a restart.
# --host 0.0.0.0 binds the fleet web server on all interfaces so the Mission
# Control dashboard is reachable on the LAN (http://<host>:8786/), matching the
# retired per-project maestro-fleet-web unit (which ran `serve --host 0.0.0.0`).
# Without it the daemon's default 127.0.0.1 bind makes the dashboard reachable
# only from the host itself. The cautious approval gate — not the network bind —
# is the write-path safety boundary.
ExecStart=/usr/local/bin/maestro daemon \
    --host 0.0.0.0 \
    --store /home/god/.maestro/maestro.db \
    --port 8786 \
    --watch-store \
    --approvals-store sqlite \
    --state-store sqlite
# Graceful in-process drain on SIGTERM: the daemon sets SpawnDrain on every flow
# (no new workers) and waits for in-flight workers to finish — there is no
# per-unit ExecStop=maestro drain anymore. The daemon's --drain-timeout (default
# 4m) now bounds the ENTIRE shutdown, including flow joins and restart markers;
# it reserves a small handoff tail inside that budget and force-exits itself at
# the deadline if a callback never returns (#966). TimeoutStopSec stays longer as
# a defense-in-depth systemd backstop, not part of normal restart latency.
TimeoutStopSec=6min
# Kill ownership is explicit (#877). New worker tmux servers run in a sibling
# transient scope (#891), so they survive maestro.service. KillMode=mixed also
# protects any legacy worker still inside this unit's cgroup: the systemd default
# KillMode=control-group would SIGTERM daemon and legacy workers together before
# the in-process drain could observe them finishing.
#
#   KillMode=mixed: the stop SIGTERM goes to the daemon's MAIN process ONLY, so
#   unit-owned descendants keep running while the daemon drains. A subsequent
#   SIGKILL still reaps this unit's control group; isolated worker scopes remain
#   independently owned by systemd and are reconciled by the replacement daemon.
#   This is deliberately NOT KillMode=process, which would leak descendants out
#   of systemd lifecycle management (rejected in #877 review).
#
# The daemon is the belt to this suspenders: any worker still in-flight near the
# deadline is checkpointed to a resumable marker before flow joins. The next
# daemon adopts the same surviving isolated PID/worktree, or resumes a legacy
# worker in place if it did exit — same logical session, exactly once
# (internal/worker/checkpoint.go, orchestrator reconcile).
KillMode=mixed
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
