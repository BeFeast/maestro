# Maestro configuration example
# Copy this file to maestro.yaml and fill in your values.
#
# For multi-project setups, create separate files:
#   maestro-panoptikon.yaml, maestro-self.yaml, etc.

repo: YOUR_ORG/YOUR_REPO
local_path: /path/to/local/repo
worktree_base: /path/to/worktrees/repo

# Code forge selection (#1172). Omit the block (or use kind: github) for the
# GitHub default. kind: forgejo routes the project's transport to a Forgejo
# instance and requires base_url — the instance ROOT (no /api/v1; the API root
# is derived automatically). token_env is the NAME of the env var holding the
# Forgejo PAT (default: FORGEJO_TOKEN) — never the token value itself.
# Note: github_projects must stay disabled on forgejo rows — the GitHub
# Projects integration has no Forgejo equivalent (the queue is labels).
# Note (#1172 M4): forgejo rows must also set review_gate: llm-review (or
# none) — the default greptile gate is a GitHub-only reviewer and is rejected
# at parse time on forgejo rows.
# Note (#1172 M5): forgejo rows are poll-only — no webhook ingestion. The
# /api/v1/webhooks/github endpoint rejects Gitea/Forgejo-origin deliveries with
# 422 (the mirror read model is GitHub-keyed); see
# docs/webhook-ingestion-runbook.md.
# forge:
#   kind: forgejo
#   base_url: https://forge.example.com
#   token_env: FORGEJO_TOKEN
max_parallel: 5
max_runtime_minutes: 120           # hard timeout per worker (default: 120)
worker_runtime:
  mode: legacy                     # legacy (default rollback path) | isolated
  scope: system                    # system for shipped maestro.service; user for a user unit
  scratch_root: /var/tmp/maestro-workers
  memory_max_mb: 0                 # optional per-worker cap; isolated workers also share a 70%/80% child-slice boundary
stalled_progress_watchdog:         # explicit opt-in; evaluates independently of GitHub/LLM cycles
  enabled: true
  max_silence_minutes: 20          # recommendation threshold; current v1 does not actuate recovery
  eval_interval_seconds: 60
worker_max_tokens: 0               # per-attempt live budget; Claude/Pi exclude cache reads (0 = unlimited)
auto_rebase: true                  # auto-rebase conflicting PR branches (default: true)
# One-shot SSH runner spike. Default off; see docs/remote-runner-spike.md.
# The v1 path requires auto_rebase: false and keeps SQLite/control-plane state local.
# remote_runner:
#   enabled: true
#   target: runner@runner.example.internal
#   repo_path: /srv/maestro/repos/PROJECT
#   worktree_base: /srv/maestro/worktrees/PROJECT
#   ssh_args: [-o, ConnectTimeout=15]
#   maestro_command: /usr/local/bin/maestro
#   credentials_file: /run/user/UID/maestro-runner/worker.env
merge_strategy: sequential         # "sequential" (default) or "parallel"
merge_interval_seconds: 30         # minimum seconds between sequential merges (default: 30)
review_gate: greptile              # "greptile" (default), "llm-review" (#1148 opus+terra pair), or "none"
review_retrigger:                  # self-heal greptile webhook misses (#691)
  enabled: true                    # post "@greptile review" when the gate wedges at pending (default: true)
  pending_minutes: 10              # re-trigger after this long pending on one head SHA (default: 10)
  cooldown_minutes: 30             # minimum gap between re-trigger comments (default: 30)

# llm-review gate (#1148) — two LLM lenses (claude-opus-5 + gpt-5.6-terra)
# replace Greptile as the primary review gate. The glue runner
# (scripts/llm-review.sh, or .github/workflows/llm-review.yml when the
# LLM_REVIEW_ENABLED repo variable is set) posts a commit status
# `llm-review-opus` / `llm-review-terra` per PR head SHA plus inline [P0]-[P3]
# findings; Maestro blocks on P0/P1 only, P2/P3 stay advisory.
# The `llm-review` gate value expands to both streams; list them in
# review_gate_streams explicitly to mix with greptile/simplicity.
# review_retrigger.missing_after_minutes bounds an absent reviewer: a gate
# with NO signal at all on the head becomes non-blocking after this many
# minutes (0 = block forever; #1115).
# review_gate: llm-review
# review_retrigger:
#   missing_after_minutes: 60
auto_retry_review_feedback: false  # retry PRs with actionable review comments
auto_retry_rebase_conflicts: false # retry PRs whose auto-rebase fails with conflicts

# Outcome brief — the supervisor uses this to judge runtime progress instead of
# raw issue throughput. For Maestro dogfooding, configure the BeFeast/maestro
# project first and point these values at the local Mission Control runtime.
# outcome:
#   desired_outcome: Maestro can supervise its own development and show a live Mission Control dashboard.
#   runtime_target: http://127.0.0.1:8786
#   runtime_url: http://127.0.0.1:8786          # alias for runtime_target
#   deployment_status_command: systemctl --user status maestro.service
#   healthcheck_url: http://127.0.0.1:8786/api/v1/state
#   verifier_command: ./scripts/verify-live-outcome.sh  # alias for healthcheck_command
#   source_repo_path: /path/to/local/maestro
#   runtime_host: local developer workstation
#   required_routes:
#     - /
#   requires_deploy: true
#   pass_required_for_done: true
#   fail_requires_visible_work: true
#   # Optional bounded hands-off recovery (#1002). Disabled by default. The
#   # command must be idempotent; Maestro persists an execution lease before
#   # launch and never stores command text or output in runtime state.
#   recovery_mode: automatic              # disabled | automatic
#   recovery_command: ./scripts/recover-live-outcome.sh
#   recovery_interval_seconds: 60
#   recovery_cooldown_minutes: 20
#   recovery_timeout_seconds: 120
#   non_goals:
#     - Mutate production deploys without explicit approval controls
#     - Generate broad issue waves automatically

# Files to auto-resolve conflicts by keeping both sides during rebase.
# Useful for generated/aggregated files that accumulate changes from multiple branches.
# auto_resolve_files:
#   - server/src/api/mod.rs
#   - web/src/lib/api.ts
#   - web/src/lib/types.ts

# Model backend — default is Claude CLI
# Supported: claude (default), codex (OpenAI), gemini, cline
claude_cmd: claude                 # deprecated: use model.backends.claude.cmd
issue_labels:                      # label filter (OR semantics); use issue_label for single label
  - enhancement
model:
  default: claude
  backends:
    claude:
      cmd: claude
      # Steer this orchestrating backend's own sub-agents to cheaper models
      # (issue #706). Claude Code spawns sub-agents and, by default, runs them
      # on the same expensive model — bulk grunt subtasks then burn the
      # subscription window at orchestrator prices, multiplied across parallel
      # sub-agents. When set, the worker prompt gains a "Sub-agent Model Policy"
      # section. Omit the field to keep the prompt unchanged.
      subagent_hint: "Use cheaper sub-agent models (e.g. opus/sonnet) for delegated grunt subtasks such as file sweeps, searches, and mechanical edits; reserve the main orchestrator model for planning and final review."
      # Optional per-backend pricing for the MC cost-observability panel
      # (issue #619). USD per million tokens. When unset, the SPA shows
      # tokens only ("price not configured") for this backend.
      # pricing:
      #   input_usd_per_mtok: 15
      #   output_usd_per_mtok: 75
      # Optional subscription quota calibration (issue #704). Maestro
      # estimates usage of the provider's 5-hour session window and
      # weekly cap from its own token counters; above dispatch_threshold
      # (default 0.85) fresh dispatches prefer fallback_backends until
      # the window resets. See docs/subscription-quota.md to calibrate.
      # quota:
      #   window_tokens: 12000000   # est. tokens per 5h session window
      #   weekly_tokens: 80000000   # est. tokens per week
      #   dispatch_threshold: 0.85  # fraction (0..1)
    codex:
      cmd: codex
      # Optional worker MCP tools. Omit this block for the safe default:
      # workers receive no MCP servers unless explicitly configured.
      # mcp:
      #   servers:
      #     docs:
      #       command: npx
      #       args: ["-y", "@example/docs-mcp"]
      #     symbols:
      #       url: https://mcp.example.com/mcp
      #       bearer_token_env_var: SYMBOLS_MCP_TOKEN
    gemini:
      cmd: gemini
    cline:
      cmd: cline          # Cline CLI — configure provider in ~/.cline/data/globalState.json

# Task-aware model routing (#783, design: docs/model-routing-rfc.md).
# OPT-IN: routing.mode defaults to "manual" (label / model.default only). With
# mode: policy, each issue is dispatched to a named strength TIER chosen by a
# deterministic first-match rule list over issue signals, and a cheap-first
# ladder climbs a tier when a task fails CI / review / retry. The model:<name>
# label still wins over the policy, and model.default is reached unchanged when
# no rule matches and no policy is configured.
#
# Recommended rollout: start with policy.shadow: true — maestro then LOGS the
# tier it *would* pick (and shows it as "backend (shadow:tier)" in `maestro
# status`) WITHOUT changing the dispatched backend. Watch a wave, tune the
# rules, then set shadow: false to enable.
#
# routing:
#   mode: policy
#   tiers:                       # each tier = a backend + optional per-tier
#     cheap:                     # effort/model override (threaded into argv for
#       backend: gemini          # codex/claude/gemini). rank orders the ladder.
#       rank: 0
#     standard:
#       backend: codex
#       effort: medium
#       rank: 1
#     strong:
#       backend: claude
#       effort: high
#       rank: 2
#   policy:
#     shadow: true               # log the would-pick without changing dispatch
#     default_tier: standard     # used when no rule matches
#     rules:                     # first match wins; deterministic
#       - when: { labels: ["model:*"] }   # documents that labels bypass policy
#         tier: passthrough
#       - when: { labels: ["security", "migration", "infra"] }
#         tier: strong
#       - when: { risk_keywords: ["migration", "schema", "auth"] }
#         tier: strong
#       - when: { size: large }            # from a size:large issue label
#         tier: strong
#       - when: { dependency: foundation } # from a dependency:foundation label
#         tier: strong
#       - when: { size: small, dependency: leaf }
#         tier: cheap
#     escalation:
#       enabled: true
#       on: [ci_failure, review_rejection, retry]  # each trigger is opt-in
#       max_tier: strong         # climb is capped here and by the retry budget
#     budget:
#       max_strong_per_wave: 3   # excess strong-tier dispatches queue at default

exclude_labels:
  - blocked
  - wontfix

# Worker prompt template (Markdown file with instructions for AI workers)
worker_prompt: /path/to/worker-prompt-template.md

# Test-first prompt variant — enforces write-tests-before-implementation workflow.
# Uses {{VALIDATION_CONTRACT}} placeholder which is replaced with VALIDATION.md content
# from the worktree (generated by the after_create hook below).
# worker_prompt: /path/to/worker-prompt-tdd.md

# Workspace lifecycle hooks
# hooks:
#   after_create: ./scripts/generate-validation.sh  # generates VALIDATION.md in worktree
#   before_run: ""                                   # runs before each agent attempt (fatal on failure)
#   after_run: ""                                    # runs after each agent attempt (logged, not fatal)
#   before_remove: ""                                # runs before workspace cleanup
#   timeout_ms: 60000                                # hook timeout in milliseconds

# Optional post-merge delivery. The explicit safe mode creates an expiring,
# exact-revision approval and runs nothing until an operator approves it.
# `verify_command` is mandatory in approval_required mode.
# delivery:
#   mode: approval_required
#   command: "./scripts/deploy.sh"
#   verify_command: "./scripts/verify-live.sh"
#   timeout_minutes: 15
#   approval_timeout_minutes: 1440   # 24h default
#   target_label: "production"
#   verification_label: "live identity and health checks"
#   rollback_label: "restore the previous accepted release"
#   target: "production"             # config-only; never persisted in approval state
#   rollback: "reinstall the previous artifact" # config-only; never persisted
# If a process dies after the durable executing claim, Maestro never replays it.
# Use the authenticated local `maestro supervise reconcile-delivery` procedure
# in docs/delivery-reconciliation-runbook.md; there is no automatic/unknown path.
#
# Legacy only: deploy_cmd maps to delivery.mode=automatic and therefore runs
# unattended after every merge. New projects should use the block above.
# deploy_cmd: "./scripts/deploy.sh"
# deploy_timeout_minutes: 15

# Opt-in self-deploy of the maestro binary itself after every merge (#698).
# Default OFF. For the dogfood project only: builds merged origin/main
# (version-stamped), installs atomically keeping the previous binary as
# <bin_path>.prev, restarts the units via a detached transient unit so the
# restart survives the orchestrator restarting itself (drain semantics are
# honored via the units' stop path), verifies the restarted process reports
# the new version, and rolls back to .prev on failure. See
# docs/self-deploy-runbook.md.
#
# Under `maestro daemon` (#758) the trigger is centralized: N project flows
# restart ONE shared maestro.service unit, so the daemon debounces every flow
# against a single marker — a wave of merges launches exactly one deploy of one
# unit — and routes the health probe to the single fleet endpoint
# (http://<host>:<port>/api/v1/fleet, default :8786).
# self_deploy:
#   enabled: true
#   bin_path: /usr/local/bin/maestro   # default: path of the running binary
#   units: ["maestro.service"]         # systemd unit(s) to restart (default: one — maestro.service)
#   # health_url: http://127.0.0.1:8788/api/v1/state  # default: derived from server.port (daemon: the fleet endpoint)
#   # health_token_env: MAESTRO_DASH_TOKEN            # default: server.auth.token_env
#   # script: ./scripts/self-deploy.sh                # default: <local_path>/scripts/self-deploy.sh
#   # timeout_minutes: 30                             # build+restart+verify budget (covers drain)

# Opt-in visual evidence for UI-affecting PRs (#705). When a PR's changed
# files match any of the path globs, the worker is instructed to run the
# capture command (a project-specific script that launches the app and writes
# screenshots to output_dir) and attach the images to the PR before declaring
# done. Missing/failed evidence produces a warning comment on the PR and a
# supervisor finding — it never blocks merge in v1. The command runs from the
# worktree root with $MAESTRO_SCREENSHOT_DIR set to the absolute output dir.
# verify:
#   visual:
#     enabled: true
#     command: ./scripts/capture-screenshots.sh
#     paths:
#       - "web/**"
#       - "**/*.jsx"
#     # output_dir: .maestro/screenshots   # default
#     # timeout_minutes: 10                # default

# Stale supervisor sessions are filtered out of the Fleet API attention list
# under two independent conditions: (a) idle past idle_after_minutes AND the
# recorded worktree is missing on disk (when require_worktree_missing=true),
# or (b) the session's linked PR (matched by branch headRef) is MERGED.
# Defaults are conservative so live workers are never reclassified:
# enabled=true, idle_after_minutes=1440 (24h), require_worktree_missing=true,
# merged_pr_dismisses=true. Set merged_pr_dismisses=false to keep behavior
# limited to the idle/worktree path.
# stale_session_reconciler:
#   enabled: true
#   idle_after_minutes: 1440
#   require_worktree_missing: true
#   merged_pr_dismisses: true

# Telegram notifications
telegram:
  target: "YOUR_TELEGRAM_CHAT_ID"
  bot_token: "YOUR_TELEGRAM_BOT_TOKEN"
  # mode: "direct" (Telegram Bot API) or "openclaw" (OpenClaw relay)
  # default: "direct"
  mode: direct
  # only needed when mode: openclaw
  # openclaw_url: "http://localhost:18789"
